# ============================================================
# GameSaving 环境变量配置
# 复制此文件为 .env 并填入真实值（.env 已被 .gitignore 排除）
# ============================================================

# ── 数据库 ──
DB_PASSWORD=your_db_password

# ── QQ 邮箱 SMTP（发送验证码、通知邮件）──
MAIL_USERNAME=your_qq_email@qq.com
MAIL_PASSWORD=your_qq_smtp_app_password

# ── Sa-Token JWT 签名密钥 ──
# 生成方式: openssl rand -base64 32
JWT_SECRET_KEY=change_me_to_a_random_256bit_string

# ── Meilisearch 搜索引擎 ──
MEILISEARCH_API_KEY=your_meilisearch_master_key

# ── 腾讯云 COS 对象存储（仅 production/cos profile 需要）──
COS_ACCESS_KEY=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_APPID=1234567890

# ── MinIO 本地 S3 测试（仅 minio profile 需要，默认值即可）──
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
